# ------------------- Required Settings -------------------
# Comma-separated list of trading pairs (supports any Binance symbol)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,MATIC/USDT

# Starting balance for paper trading (in USD/stablecoin equivalent)
INITIAL_BALANCE=10000.0

# Risk Management
MAX_POSITIONS_GLOBAL=5          # Max open positions across all assets
MAX_POSITIONS_PER_SYMBOL=1      # Max positions per individual coin
PER_TRADE_RISK_PCT=0.02         # 2% of balance risked per trade
MAX_DAILY_LOSS_PCT=0.05         # Stop trading if daily loss >5% of initial balance
CONSECUTIVE_LOSS_LIMIT=3        # Halt after 3 losing trades in a row
CONSENSUS_THRESHOLD=0.60        # Minimum weighted consensus (0.5–0.7 recommended)

# Scan frequency (seconds)
TRADE_INTERVAL_SECONDS=60

# Telegram (required for alerts & commands)
TELEGRAM_TOKEN="8873250231:AAHGbyzL_W0AuJHg0l_T6yTtucwLlJ1g3Yo"
TELEGRAM_CHAT_ID="1082143881"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------- Optional: Live Trading -------------------
# Leave EXCHANGE_NAME empty to run in paper trading mode.
# To enable live trading, set all three and replace the placeholder LiveBroker class with ccxt.
EXCHANGE_NAME=          # e.g., binance, bybit, kucoin
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# ------------------- Optional: Adjust Source Weights -------------------
# Each weight affects how much a signal source influences consensus.
WEIGHT_MA=0.6
WEIGHT_RSI=0.4
WEIGHT_ORDERBOOK=0.8
WEIGHT_WHALE=0.7
WEIGHT_SENTIMENT=0.5